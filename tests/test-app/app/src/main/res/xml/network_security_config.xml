<?xml version="1.0" encoding="utf-8"?>
<!-- A pin-set that matches nothing: platform trust must reject every chain for the test host.
     Reached by the conscrypt custom_verify wrap (surface platform_tls), never by DEX patching. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">example.com</domain>
        <pin-set>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
